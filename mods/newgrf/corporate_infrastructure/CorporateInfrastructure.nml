// Corporate Infrastructure 0.1 - graphical proof of concept.
// 32bpp RGBA sprites, with a 2x in-zoom alternative.
// This implements PLACEABLE OBJECTS ONLY. It does not provide working industries,
// airports, aircraft, rail or cargo transfer. Large art is anchored on the
// north-most tile of each 4x4 object; in-game depth sorting must be tested.
grf {
    grfid: "CI\01\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESCRIPTION);
    version: 1;
    min_compatible_version: 1;
}
// Data Centre — 4x4 decorative object
spriteset(sprite_data_centre, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/data_centre_1x.png") {
    [0, 0, 240, 186, -120, -58]
}
alternative_sprites(sprite_data_centre, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/data_centre_2x.png") {
    [0, 0, 480, 372, -240, -117]
}
spritelayout layout_data_centre {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    building {
        sprite: sprite_data_centre(0);
        xextent: 64;
        yextent: 64;
        zextent: 90;
    }
}
// The remaining 15 tiles draw only ground, so the image is not repeated.
spritelayout layout_data_centre_ground {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
}
switch (FEAT_OBJECTS, SELF, select_data_centre, relative_pos) {
    0: layout_data_centre;
    layout_data_centre_ground;
}
item (FEAT_OBJECTS, object_data_centre, 0) {
    property {
        class: "CI01";
        classname: string(STR_CLASS);
        name: string(STR_DATA_CENTRE);
        climates_available: ALL_CLIMATES;
        size: [4, 4];
        build_cost_multiplier: 4;
        remove_cost_multiplier: 3;
        introduction_date: date(1900, 1, 1);
        end_of_life_date: 0xFFFFFFFF;
        object_flags: bitmask(OBJ_FLAG_NO_FOUNDATIONS);
        height: 22;
        num_views: 1;
    }
    graphics {
        default: select_data_centre;
        purchase: layout_data_centre;
        tile_check: ((extra_callback_info1 & bitmask(0,1,2,3,4)) == 0) ? CB_RESULT_LOCATION_ALLOW : CB_RESULT_LOCATION_DISALLOW;
    }
}
