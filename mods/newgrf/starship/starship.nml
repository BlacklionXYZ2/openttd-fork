tilelayout starship_pad_layout {
    rotation: DIRECTION_NORTH;
    0, 0: pad_tile_0_0;
    1, 0: pad_tile_1_0;
    2, 0: pad_tile_2_0;
    3, 0: pad_tile_3_0;
    4, 0: pad_tile_4_0;
    0, 1: pad_tile_0_1;
    1, 1: pad_tile_1_1;
    2, 1: pad_tile_2_1;
    3, 1: pad_tile_3_1;
    4, 1: pad_tile_4_1;
    0, 2: pad_tile_0_2;
    1, 2: pad_tile_1_2;
    2, 2: pad_tile_2_2;
    3, 2: pad_tile_3_2;
    4, 2: pad_tile_4_2;
    0, 3: pad_tile_0_3;
    1, 3: pad_tile_1_3;
    2, 3: pad_tile_2_3;
    3, 3: pad_tile_3_3;
    4, 3: pad_tile_4_3;
}

/* The first NewGRF airport based on a built-in airport replaces it. This unchanged copy of the country airport
 * takes that place, so the launch site is added rather than taking the country airport away from players. */
item(FEAT_AIRPORTS, country_airport_unchanged, 0) {
    property {
        override: 0;
    }
}

item(FEAT_AIRPORTS, starship_launch_site, 1) {
    property {
        override:         0;
        name:             string(STR_STARSHIP_LAUNCH_SITE);
        layouts:          [starship_pad_layout];
        years_available:  [2045, 65535];
        catchment_area:   6;
        noise_level:      25;
        maintenance_cost: 80;
        badges: ["fl_format/2", "fl_id/starship_launch_site", "fl_tech/rocket", "fl_provides/launchpad"];
    }
}
