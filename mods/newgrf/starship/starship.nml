/*
 * Future Logistics: Starship. GPL-2.0-only.
 *
 * A fully reusable rocket and its launch site, described with the Future Logistics tech format
 * (docs/future_logistics/tech_format.md). It joins the shared "rocket" family, so it works on its own and
 * alongside the Future Logistics NewGRF, whose rocket and spaceport belong to the same family. Rival
 * companies adopt it through their rules for new air families (AeroLink's any/airport_pair/any/2).
 *
 * Every number is a placeholder until the balance pass; see PLACEHOLDERS.md. The graphics come from the
 * Corporate Infrastructure handoff art, converted by tools/make_sprites.py.
 *
 * Build with NML 0.9.0: ./build.sh
 */
grf {
    grfid: "FL\01\02";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 1;
    min_compatible_version: 1;
}

cargotable {
    PASS, MAIL
}

badgetable {
    "fl_format/2",
    /* The rocket family, declared here too so the package works without the Future Logistics NewGRF. */
    "fl_family/rocket",
    "fl_family/rocket/mechanic/airport_pair",
    "fl_family/rocket/market/town_pair",
    "fl_family/rocket/market/mail",
    "fl_family/rocket/market/industry",
    "fl_family/rocket/min_tier/city",
    "fl_tech/rocket",
    "fl_tier/4",
    "fl_needs/launchpad",
    "fl_provides/launchpad",
    "fl_role/passenger_intercity",
    "fl_role/express",
    "fl_role/freight_general",
    "fl_id/starship",
    "fl_id/starship_launch_site",
    /* Shared badge classes from the NewGRF specification, for other NewGRFs, AIs and the purchase list. */
    "role/passenger",
    "role/mail",
    "role/freight",
    "power/rocket",
}

/* Only the family has a display name; the fl_ classes stay unnamed so players never see them. */
item(FEAT_BADGES, family_rocket, 0) { property { label: "fl_family/rocket"; name: string(STR_FAMILY_ROCKET); } }

/* Starship. The same upright sprite serves every direction; the powered sprite, with its flame, is shown
 * once it is moving fast enough to have taken off. For aircraft, current_speed is in units of about
 * 12.8 km/h, so 20 is about 256 km/h: well above taxiing speed. Vertical launch and landing would need engine work: it
 * flies between launch sites like an aircraft. */
spriteset(starship_idle, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/rocket_idle_1x.png") {
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
    [0, 0, 7, 44, -3, -42]
}
alternative_sprites(starship_idle, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/rocket_idle_2x.png") {
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
    [0, 0, 13, 88, -6, -84]
}

spriteset(starship_powered, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/rocket_powered_1x.png") {
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
    [0, 0, 9, 48, -4, -46]
}
alternative_sprites(starship_powered, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/rocket_powered_2x.png") {
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
    [0, 0, 19, 95, -9, -91]
}

switch (FEAT_AIRCRAFT, SELF, starship_graphics, current_speed > 20) {
    1: starship_powered;
    starship_idle;
}

item(FEAT_AIRCRAFT, starship, 64) {
    property {
        name:                         string(STR_STARSHIP);
        climates_available:           ALL_CLIMATES;
        introduction_date:            date(2045, 1, 1);
        model_life:                   50;
        vehicle_life:                 30;
        reliability_decay:            15;
        loading_speed:                80;
        sprite_id:                    SPRITE_ID_NEW_AIRCRAFT;
        aircraft_type:                AIRCRAFT_TYPE_LARGE;
        /* Balanced as the top of the transport world: the most expensive vehicle to buy and to run (both
         * factors at their maximum), the largest capacity, and the most profit. See PLACEHOLDERS.md. */
        cost_factor:                  255;
        running_cost_factor:          255;
        speed:                        2000 km/h;
        acceleration:                 50;
        passenger_capacity:           500;
        mail_capacity:                120;
        refittable_cargo_classes:     bitmask(CC_PASSENGERS, CC_MAIL, CC_EXPRESS, CC_ARMOURED);
        range:                        0;
        sound_effect:                 SOUND_TAKEOFF_JET_FAST;
        badges: ["fl_format/2", "fl_id/starship", "fl_tech/rocket", "fl_tier/4", "fl_needs/launchpad",
                 "fl_role/passenger_intercity", "fl_role/express", "fl_role/freight_general",
                 "role/passenger", "role/mail", "role/freight", "power/rocket"];
    }
    graphics {
        default:  starship_graphics;
        purchase: starship_idle;
    }
}

/* Launch site. A city airport's runway, taxiways and hangar, with the launch pad from the handoff art drawn
 * over its northern 4x4 tiles. Each pad tile draws one piece of the art on concrete; aircraft movement comes
 * from the city airport and does not depend on the tiles' graphics. */
spriteset(pad_sprite_0_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/pad_0_0_1x.png") { [0, 0, 81, 137, -45, -105] }
alternative_sprites(pad_sprite_0_0, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/pad_0_0_2x.png") { [0, 0, 162, 274, -91, -210] }
spritelayout pad_layout_0_0 {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    childsprite { sprite: pad_sprite_0_0(0); }
}
item(FEAT_AIRPORTTILES, pad_tile_0_0, 0) {
    property { substitute: 0; }
    graphics { default: pad_layout_0_0; }
}

spriteset(pad_sprite_1_0, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/pad_1_0_1x.png") { [0, 0, 78, 39, -31, -7] }
