tilelayout starship_pad_layout {
    rotation: DIRECTION_NORTH;
    0, 0: pad_tile_0_0;
    1, 0: pad_tile_1_0;
    2, 0: pad_tile_2_0;
    3, 0: pad_tile_3_0;
    4, 0: 1; /* APT_APRON_FENCE_NW */
    5, 0: 24; /* APT_DEPOT_SE */
    0, 1: pad_tile_0_1;
    1, 1: pad_tile_1_1;
    2, 1: pad_tile_2_1;
    3, 1: pad_tile_3_1;
    4, 1: 0; /* APT_APRON */
    5, 1: 2; /* APT_APRON_FENCE_SW */
    0, 2: pad_tile_0_2;
    1, 2: pad_tile_1_2;
    2, 2: pad_tile_2_2;
    3, 2: pad_tile_3_2;
    4, 2: 12; /* APT_APRON_HOR */
    5, 2: 13; /* APT_APRON_N_FENCE_SW */
    0, 3: pad_tile_0_3;
    1, 3: pad_tile_1_3;
    2, 3: pad_tile_2_3;
    3, 3: pad_tile_3_3;
    4, 3: 11; /* APT_ARPON_N */
    5, 3: 20; /* APT_TOWER_FENCE_SW */
    0, 4: 30; /* APT_EMPTY_FENCE_NE */
    1, 4: 5; /* APT_APRON_S */
    2, 4: 7; /* APT_APRON_HOR_CROSSING_W */
    3, 4: 8; /* APT_APRON_VER_CROSSING_N */
    4, 4: 10; /* APT_APRON_E */
    5, 4: 31; /* APT_RADAR_GRASS_FENCE_SW */
    0, 5: 18; /* APT_RUNWAY_END_FENCE_SE */
    1, 5: 14; /* APT_RUNWAY_1 */
    2, 5: 15; /* APT_RUNWAY_2 */
    3, 5: 16; /* APT_RUNWAY_3 */
    4, 5: 17; /* APT_RUNWAY_4 */
    5, 5: 18; /* APT_RUNWAY_END_FENCE_SE */
}

/* The first NewGRF airport based on a built-in airport replaces it. This unchanged copy of the city airport
 * (type 1) takes that place, so the launch site is added rather than taking the city airport from players.
 * The Future Logistics NewGRF has the same copy; with both loaded, only one is needed. */
if (!grf_future_status("FL\01\01")) {
    item(FEAT_AIRPORTS, city_airport_unchanged, 0) {
        property {
            override: 1;
        }
    }
}

item(FEAT_AIRPORTS, starship_launch_site, 1) {
    property {
        override:         1;
        name:             string(STR_STARSHIP_LAUNCH_SITE);
        layouts:          [starship_pad_layout];
        years_available:  [2045, 65535];
        catchment_area:   6;
        noise_level:      25;
        maintenance_cost: 80;
        badges: ["fl_format/2", "fl_id/starship_launch_site", "fl_tech/rocket", "fl_provides/launchpad"];
    }
}
